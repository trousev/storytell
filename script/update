#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR"

FORCE=0
if [ "$1" = "--force" ]; then
    FORCE=1
fi

if [ -d .venv ] && [ $FORCE -eq 0 ]; then
    echo "Syncing dependencies with uv..."
    uv sync
    echo "Done."
    exit 0
fi

if [ -d .venv ]; then
    echo "Removing existing .venv..."
    rm -rf .venv
fi

echo "Creating virtual environment with uv..."
uv venv .venv --python python3 --seed

echo "Installing dependencies..."
uv sync

echo "Running migrations..."
uv run python manage.py migrate

echo "Downloading silero model..."
mkdir -p .cache/silero
CACHE_DIR="$(pwd)/.cache/silero"
MODEL_FILE="$CACHE_DIR/v5_ru.pt"
MODEL_YML="$CACHE_DIR/models.yml"
if [ ! -f "$MODEL_FILE" ]; then
    uv run python -c "
import torch
import os
os.makedirs('$CACHE_DIR', exist_ok=True)
torch.hub.download_url_to_file('https://models.silero.ai/models/tts/ru/v5_ru.pt', '$MODEL_FILE', progress=True)
torch.hub.download_url_to_file('https://raw.githubusercontent.com/snakers4/silero-models/master/models.yml', '$MODEL_YML', progress=True)
"
    echo "Silero model downloaded."
else
    echo "Silero model already exists, skipping download."
fi

echo "Done. Activate with: source .venv/bin/activate"