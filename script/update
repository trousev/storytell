#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR"

export PYENV_VERSION=3.12.8
export CUDA_HOME=/usr/local/cuda
export PATH=$CUDA_HOME/bin:$PATH

FORCE=0
if [ "$1" = "--force" ]; then
    FORCE=1
fi

if [ -d .venv ] && [ $FORCE -eq 0 ]; then
    echo "Using existing .venv. Use --force to recreate."
    .venv/bin/pip install -e ".[dev]" --quiet
    exit 0
fi

if [ -d .venv ]; then
    echo "Removing existing .venv..."
    rm -rf .venv
fi

echo "Creating virtual environment with Python $PYENV_VERSION..."
pyenv exec python -m venv .venv

echo "Upgrading pip..."
.venv/bin/pip install --upgrade pip

echo "Installing dependencies..."
.venv/bin/pip install -e ".[dev]"

echo "Installing flash-attn..."
.venv/bin/pip install flash-attn --no-build-isolation || echo "flash-attn install failed (continuing...)"

echo "Done. Activate with: source .venv/bin/activate"